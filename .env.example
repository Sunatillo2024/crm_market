# Django
DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,web

# PostgreSQL
DB_NAME=minimarket_crm
DB_USER=minimarket_user
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Docker host ports
DB_HOST_PORT=5434
WEB_PORT=8001

# Optional: Docker entrypoint creates this account only when all values are set.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
